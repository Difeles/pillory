  "fixed_sql": [
    {
      "name": "medicines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medicines\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"form\" TEXT NULL, \"strength\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "medicine_packages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medicine_packages\" (\"id\" TEXT NOT NULL, \"medicine_id\" TEXT NOT NULL REFERENCES medicines (id) ON DELETE CASCADE, \"initial_quantity\" REAL NOT NULL CHECK(\"initial_quantity\" >= 0.0), \"quantity\" REAL NOT NULL CHECK(\"quantity\" >= 0.0), \"unit\" TEXT NOT NULL, \"expires_on\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "inventory_transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory_transactions\" (\"id\" TEXT NOT NULL, \"package_id\" TEXT NOT NULL REFERENCES medicine_packages (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"delta\" REAL NOT NULL, \"quantity_after\" REAL NOT NULL CHECK(\"quantity_after\" >= 0.0), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedules\" (\"id\" TEXT NOT NULL, \"medicine_id\" TEXT NOT NULL REFERENCES medicines (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"weekdays\" TEXT NOT NULL DEFAULT '', \"dates\" TEXT NOT NULL DEFAULT '', \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"times\" TEXT NOT NULL DEFAULT '', \"dose\" REAL NOT NULL CHECK(\"dose\" > 0.0), \"dose_unit\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "intake_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"intake_logs\" (\"id\" TEXT NOT NULL, \"schedule_id\" TEXT NOT NULL REFERENCES schedules (id) ON DELETE CASCADE, \"day\" TEXT NOT NULL, \"slot\" INTEGER NOT NULL DEFAULT -1, \"taken_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"schedule_id\", \"day\", \"slot\"));"
        }
      ]
    },
    {
      "name": "idx_packages_medicine",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX idx_packages_medicine ON medicine_packages (medicine_id)"
        }
      ]
    },
